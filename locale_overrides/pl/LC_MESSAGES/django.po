# Hand-maintained Polish translations for strings owned by third-party
# packages (currently: django-unfold, which ships no locale/ of its own —
# see config/settings.py LOCALE_PATHS). Deliberately kept OUT of the
# project's own locale/ directory so `manage.py makemessages --no-obsolete`
# never prunes these entries (it only scans our own source tree, never
# .venv/site-packages, so it can't find where these msgids are used and
# would otherwise delete them on the next run).
#
# Keep this file minimal: only add an entry here once you've confirmed,
# by reading the third-party package's source, that it really ships no
# translation for that string in any language it bundles.
msgid ""
msgstr ""
"Project-Id-Version: PACKAGE VERSION\n"
"Report-Msgid-Bugs-To: \n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

