# DJANGO
SECRET_KEY = 'напишите_сюда_любой_длинный_пароль_но_лучше_сгенерить'
DEBUG = TRUE
ALLOWED_HOSTS=127.0.0.1,localhost
# для прода: ALLOWED_HOSTS=crm.shalyn42k.pl

# CSRF (нужно для прода, в dev можно оставить пустым)
# для прода: CSRF_TRUSTED_ORIGINS=https://crm.shalyn42k.pl
CSRF_TRUSTED_ORIGINS=

# DB
# для dev DB_HOST=127.0.0.1 и DB_PORT=5434 (так Postgres из docker-compose маппится наружу)
# для прода DB_HOST=db и DB_PORT=5432 (имя сервиса внутри docker-сети)
DB_NAME = 'свой'
DB_USER = 'свой'
DB_PASSWORD = 'свой'
DB_PORT = 5434
DB_HOST = 127.0.0.1

# EMAIL / SMTP — стандартные Django-имена.
# EMAIL_BACKEND по дефолту smtp; в dev'е можно ставить console (письма уйдут в stdout):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
# Gmail: НЕ обычный пароль аккаунта. Сгенерируйте App Password в настройках Google
# (если включена 2FA — обязательно). Для других провайдеров — соответствующий секрет.
EMAIL_HOST_PASSWORD=
# Адрес "от кого" в исходящих письмах. Если не задано — settings.py берёт EMAIL_HOST_USER.
# НЕ оставляйте пустую строку явно (DEFAULT_FROM_EMAIL=) — SMTP отобьёт "Invalid address".
# DEFAULT_FROM_EMAIL=

# UI — сколько строк на страницу во всех admin changelist'ах и в inbox.
# Применяется глобально через monkey-patch в NotificationConfig.ready().
PAGE_SIZE=20

# CLOUDFLARE TUNNEL (нужен только на проде)
# токен берётся в UI Cloudflare при создании туннеля
CLOUDFLARE_TUNNEL_TOKEN=
